{
  "name": "lxc-container-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "로컬 Docker 컨테이너를 관리하는 데스크톱 콘솔",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix frontend run build",
    "check": "node --check server.js && node --check docker-engine.js && npm --prefix frontend run build",
    "test": "node --test",
    "desktop": "npm run build && electron .",
    "desktop:start": "electron ."
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-pty": "^1.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
